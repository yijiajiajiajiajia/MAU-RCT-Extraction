    "country": "Korea, Taiwan, Italy",
    "doi": "10.1245/s10434-022-11865-x",
    "study_design": "International multicenter pooled analysis of individual patient-level data from retrospective and prospective studies; propensity score-matched analyses were performed to adjust for confounding factors.",
    "inclusion_criteria": "Women who underwent nipple-sparing mastectomy with immediate breast reconstruction between June 2014 and March 2020 at four medical centers.",
    "exclusion_criteria": "Stage IV disease at initial presentation, cases without IBR, or previous breast surgery.",
    "study_setting": "Four medical centers: Severance Hospital (Seoul, Korea), Samsung Medical Center (Seoul, Korea), European Institute of Oncology IRCCS (Milan, Italy), and Changhua Christian Hospital (Changhua, Taiwan).",
    "source_of_recruitment": "Patients were recruited from four medical centers: Severance Hospital, Samsung Medical Center, European Institute of Oncology IRCCS, and Changhua Christian Hospital.",
    "number_of_participants_randomized": null,
    "number_of_participants_analyzed": "755 procedures in 659 women",
    "dropout_reasons": "Nipple areolar complex resection, no reconstruction, previous operation history, stage IV disease, and data duplication.",
