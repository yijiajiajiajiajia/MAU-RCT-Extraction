    "study_id": "text5-9",
    "title": "Effect of Oral Alfacalcidol on Clinical Outcomes in Patients Without Secondary Hyperparathyroidism Receiving Maintenance Hemodialysis The J-DAVID Randomized Clinical Trial",
    "authors": "The J-DAVID Investigators; Tetsuo Shoji, MD; Masaaki Inaba, MD; Masafumi Fukagawa, MD; Ryoichi Ando, MD; Masanori Emoto, MD; Hisako Fujii, PhD; Akira Fujimori, MD; Mitsuru Fukui, PhD; Hiroki Hase, MD; Tetsuya Hashimoto, MD; Hideki Hirakata, MD; Hirokazu Honda, MD; Tatsuo Hosoya, MD; Yuji Ikari, MD; Daijo Inaguma, MD; Toru Inoue, MD; Yoshitaka Isaka, MD; Kunitoshi Iseki, MD; Eiji Ishimura, MD; Noritomo Itami, MD; Chiharu Ito, MD; Toshitaka Kakuta, MD; Toru Kawai, MD; Hideki Kawanishi, MD; Shuzo Kobayashi, MD; Junko Kumagai, MD; Kiyoshi Maekawa, MD; Ikuto Masakane, MD; Jun Minakuchi, MD; Koji Mitsuiki, MD; Takashi Mizuguchi, MD; Satoshi Morimoto, MD; Toyoaki Murohara, MD; Tatsuya Nakatani, MD; Shigeo Negi, MD; Shinichi Nishi, MD; Mitsushige Nishikawa, MD; Tetsuya Ogawa, MD; Kazumichi Ohta, MD; Takayasu Ohtake, MD; Mikio Okamura, MD; Senji Okuno, MD; Takashi Shigematsu, MD; Toshitsugu Sugimoto, MD; Masashi Suzuki, MD; Hideki Tahara, MD; Yoshiaki Takemoto, MD; Kenji Tanaka, MD; Yoshihiro Tominaga, MD; Yoshiharu Tsubakihara, MD; Yoshihiro Tsujimoto, MD; Kazuhiko Tsuruya, MD; Shinichiro Ueda, MD; Yuzo Watanabe, MD; Kunihiro Yamagata, MD; Tomoyuki Yamakawa, MD; Shozo Yano, MD; Keitaro Yokoyama, MD; Noriaki Yorioka, MD; Minoru Yoshiyama, MD; Yoshiki Nishizawa, MD.",
    "year": "2018",
    "journal": "JAMA",
    "country": "Japan",
    "doi": "10.1001/jama.2018.17749",
    "study_design": "Randomized, open-label, blinded end point multicenter clinical trial. Randomization was performed using a computer-generated random sequence with a block randomization method stratified by age, sex, years receiving dialysis, underlying renal disease, and history of CVD. Central randomization was conducted via fax between dialysis facilities and the data center.",
    "inclusion_criteria": "Patients aged 20 to 80 years receiving maintenance hemodialysis; serum calcium less than or equal to 10.0 mg/dL, phosphate less than or equal to 6.0 mg/dL, and intact PTH level less than or equal to 180 pg/mL; not taking any VDRAs at randomization.",
    "exclusion_criteria": "Not explicitly listed in the main text; additional criteria are referenced as being in eTable 1 in Supplement 3.",
    "study_setting": "Multicenter study conducted at 207 dialysis centers in Japan.",
    "source_of_recruitment": "Eligible patients were recruited from 207 dialysis centers in Japan between July 1, 2008, and January 26, 2011.",
    "number_of_participants_randomized": "976",
    "number_of_participants_analyzed": "964 (488 in intervention group, 476 in control group)",
    "dropout_reasons": "No information was recorded on why the participants discontinued their treatment. Although the reasons are likely to be laboratory abnormalities, such as high serum calcium in the intervention group and high intact PTH levels in the control group, no data are available in case report forms.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
