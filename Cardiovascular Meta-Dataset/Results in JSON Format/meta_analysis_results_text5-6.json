{
  "study_info": {
    "study_id": "text5-6",
    "title": "Effect of Paricalcitol on Left Ventricular Mass and Function in CKD-The OPERA Trial",
    "authors": "Angela Yee-Moon Wang, Fang Fang, John Chan, Yue-Yi Wen, Shang Qing, Iris Hiu-Shuen Chan, Gladys Lo, Kar-Neng Lai, Wai-Kei Lo, Christopher Wai-Kei Lam, and Cheuk-Man Yu",
    "year": "2014",
    "journal": "Journal of the American Society of Nephrology",
    "country": "Hong Kong, China",
    "doi": "10.1681/ASN.2013010103",
    "study_design": "Prospective, double blind, randomized, placebo-controlled trial. Randomization schedule was computer-generated by the sponsor using the WebRando System (Abbvie), with block sizes of two or four, stratified by iPTH level.",
    "inclusion_criteria": "Age 18-75 years, stages 3–5 nondialysis CKD, GFR <60 ml/min per 1.73 m2 for more than 3 months, not expected to start dialysis within 12 months, screening iPTH ≥55 pg/ml, serum calcium <10.2 mg/dl (2.55 mmol/L), serum phosphorus ≤5.2 mg/dl (1.68 mmol/L), calcium × phosphorus product <54 mg2/dl2 (4.36 mmol2/L2), no vitamin D therapy in previous 4 weeks, for women: not of childbearing potential or using birth control, RAS blocker dose unaltered for at least 3 months, echocardiographic evidence of LV hypertrophy (LV mass index >115 g/m2 in men and >95 g/m2 in women).",
    "exclusion_criteria": "History of allergic reaction to vitamin D or related compounds, history of renal stones, current malignancy, clinically significant gastrointestinal or liver disease, acute renal failure in the recent 3 months, history of drug or alcohol abuse within 6 months before screening, known HIV-positive status, evidence of poor compliance with diet and medication, active granulomatous disease, currently receiving medications that may affect calcium or phosphorus metabolism (such as calcitonin, cinacalcet, bisphosphonates, or vitamin D compounds), currently receiving or had received glucocorticoid or other immunosuppressive treatment for more than 14 days within the recent 6 months before screening, use of stable estrogen and/or progestogen therapy, pregnancy, and contraindications for MRI examination.",
    "study_setting": "University teaching hospital and a major regional tertiary care hospital in Hong Kong.",
    "source_of_recruitment": "Renal Clinic of the Queen Mary Hospital in Hong Kong",
    "number_of_participants_randomized": "60",
    "number_of_participants_analyzed": "59 for primary analysis, 60 for secondary analysis",
    "dropout_reasons": "No dropouts; one patient in the placebo group was not analyzed in the primary end point because of loss of cardiac MR images.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
