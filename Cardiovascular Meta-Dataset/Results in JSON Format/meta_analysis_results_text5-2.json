{
  "study_info": {
    "study_id": "text5-2",
    "title": "Clinical and Laboratory Safety of One Year's Use of a Combination Calcium + Vitamin D Tablet in Ambulatory Elderly Women with Vitamin D Insufficiency: Results of a Multicenter, Randomized, Double-Blind, Placebo-Controlled Study",
    "authors": "Michel Brazier, MD, PhD; Franck Grados, MD; Said Kamel, PhD; Marc Mathieu, MD; Alain Morel, BS; Mohamed Maamer, PhD; Jean-Luc Sebert, MD; and Patrice Fardellone, MD, PhD",
    "year": "2005",
    "journal": "Clinical Therapeutics",
    "country": "France",
    "doi": null,
    "study_design": "Multicenter, randomized, double-blind, placebo-controlled trial. Randomization was performed using 4-block equilibrated randomization.",
    "inclusion_criteria": "Community-dwelling ambulatory women aged >65 years who spontaneously consulted a practitioner and presented with vitamin D insufficiency (serum 25-hydroxyvitamin D ≤12 ng/mL).",
    "exclusion_criteria": "Hypercalcemia (serum calcium >2.62 mmol/L), primary hyperparathyroidism, renal insufficiency (serum creatinine >130 μmol/L), hepatic insufficiency, or use of bisphosphonate, calcitonin, vitamin D or its metabolites, estrogen, raloxifene, fluoride, anticonvulsives, or any other treatment acting on bone metabolism (e.g., glucocorticoids) in the past 6 months.",
    "study_setting": "50 centers in 10 administrative regions throughout France",
    "source_of_recruitment": "Community-dwelling ambulatory women aged >65 years who spontaneously consulted a practitioner",
    "number_of_participants_randomized": "192",
    "number_of_participants_analyzed": "192",
    "dropout_reasons": "Premature withdrawal occurred in 21 (22.1%) women who received calcium + vitamin D and 29 (30.2%) women who received placebo, mainly the result of adverse events or the patient's request.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
