    "study_id": "text5-16",
    "title": "Evaluation of a fall-prevention program in older people after femoral neck fracture: a one-year follow-up",
    "authors": "M. Berggren & M. Stenvall & B. Olofsson & Y. Gustafson",
    "year": "2008",
    "journal": "Osteoporosis International",
    "country": "Sweden",
    "doi": "10.1007/s00198-007-0507-9",
    "study_design": "Randomized controlled trial. Randomization was performed by someone not involved in the study, using sequentially numbered, stratified lots in opaque, sealed envelopes, opened immediately before surgery.",
    "inclusion_criteria": "Participants with femoral neck fractures aged 70 years or older admitted consecutively to the orthopedic department at the Umeå University Hospital in Umeå, Sweden, between May 2000 and December 2002.",
    "exclusion_criteria": "Rheumatoid arthritis, severe hip osteoarthritis, pathological fracture, severe renal failure, bedridden before the fracture, and those for whom the planned operation was not appropriate as decided by the anesthesiologist.",
    "study_setting": "Umeå University Hospital, Sweden; orthopedic department and geriatric rehabilitation department.",
    "source_of_recruitment": "Consecutive admissions to the orthopedic department at Umeå University Hospital.",
    "number_of_participants_randomized": "199",
    "number_of_participants_analyzed": "At 12 months, 76 in control group and 84 in intervention group were assessed (total 160).",
    "dropout_reasons": "Death during hospitalization, death after discharge, declined to continue, moved to another city.",
