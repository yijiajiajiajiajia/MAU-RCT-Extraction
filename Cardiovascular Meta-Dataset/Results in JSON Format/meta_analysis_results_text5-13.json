    "study_id": "text5-13",
    "title": "Prevention of Femoral and Lumbar Bone Loss with Hormone Replacement Therapy and Vitamin D3 in Early Postmenopausal Women: A Population-Based 5-Year Randomized Trial",
    "authors": "MARJA KOMULAINEN, HEIKKI KROGER, MARJO T. TUPPURAINEN, ANNA-MARI HEIKKINEN, ESKO ALHAVA, RISTO HONKANEN, JUKKA JURVELIN, AND SEPPO SAARIKOSKI",
    "year": "1999",
    "journal": "Journal of Clinical Endocrinology and Metabolism",
    "country": "Finland",
    "doi": null,
    "study_design": "Population-based 5-year randomized trial with factorial design; randomization method not detailed",
    "inclusion_criteria": "Recently postmenopausal women (6–24 months since last menstruation), willing to participate, without contraindications to HRT",
    "exclusion_criteria": "History of breast or endometrial cancer, thromboembolic diseases, and medication-resistant hypertension; women who wanted to change treatment groups were excluded; osteoporotic women withdrawn after enrollment if baseline lumbar or femoral BMD above 2 sd of the mean of the whole study population",
    "study_setting": "Kuopio University Hospital and University of Kuopio, Kuopio, Finland",
    "source_of_recruitment": "Subsample of the Kuopio Osteoporosis Risk Factor and Prevention Study, which started with a postal inquiry sent to all 47- to 56-year-old women of Kuopio Province",
    "number_of_participants_randomized": "464",
    "number_of_participants_analyzed": "435",
    "dropout_reasons": "20 women could not be contacted at the end of the study, 3 died from unrelated causes, 6 osteoporotic women withdrawn after enrollment when subject eligibility data were available",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
