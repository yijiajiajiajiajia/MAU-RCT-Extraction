{
  "study_info": {
    "study_id": "text4-1",
    "title": "A 1-year, double-blind, placebo-controlled trial of ziprasidone 40, 80 and 160 mg/day in chronic schizophrenia: the Ziprasidone Extended Use in Schizophrenia (ZEUS) study",
    "authors": "M. Arato, R. O’Connor and H.Y. Meltzer on behalf of the ZEUS Study Group",
    "year": "2002",
    "journal": "International Clinical Psychopharmacology",
    "country": "Europe (26 European centres), with authors/investigators from Hungary, USA, Czech Republic, Poland, Hungary, Estonia",
    "doi": null,
    "study_design": "Randomized, double-blind, parallel-group, placebo-controlled trial; randomization by computer-generated pseudorandom code",
    "inclusion_criteria": "Inpatients, aged 18 years or older, with chronic, stable schizophrenia (DSM-III-R), hospitalized for at least 2 months, and scores of ≤5 (markedly ill) on the Clinical Global Impression of Severity scale (CGIS). Previous treatment with ziprasidone was prohibited. Women of childbearing potential were eligible if they were using reliable contraception.",
    "exclusion_criteria": "Recent acute exacerbation of schizophrenia, score of ≥5 on items P7 (hostility) or G8 (uncooperativeness) of the PANSS, significant risk of suicide, treatment resistance (defined as lack of therapeutic response to a conventional antipsychotic during an acute exacerbation on at least two occasions in the previous 2 years), substance abuse or dependence in the previous 3 months, treatment with depot neuroleptics unless the last injection had been at least one treatment cycle before entry, investigational drug within the previous 4 weeks, fluoxetine in the previous 5 weeks, monoamine oxidase inhibitors in the previous 2 weeks, or antidepressants or lithium in the previous week, pregnant or breast-feeding women.",
    "study_setting": "Inpatient, long-term care facilities in 26 European centres; patients remained as inpatients for the duration of the study.",
    "source_of_recruitment": "26 European centres with facilities for long-term care of the mentally ill",
    "number_of_participants_randomized": "294",
    "number_of_participants_analyzed": "294 (after exclusion of 16 patients from one centre for protocol deviation)",
    "dropout_reasons": "Withdrawal due to relapse, adverse events, laboratory abnormalities, and other reasons (hospital transfer, withdrawn consent, lost-to-follow up, administrative reasons).",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
