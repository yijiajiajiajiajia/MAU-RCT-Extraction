{
  "study_info": {
    "study_id": "text4-30",
    "title": "Clinical and Social Comparison of Fluphenazine Decanoate and Flupenthixol Decanoate in the Community Maintenance Therapy of Schizophrenia",
    "authors": "H. B. Kelly, H.L. Freeman, B. Banning and A.A. Schiff",
    "year": "1977",
    "journal": "International Pharmacopsychiatry",
    "country": "United Kingdom (England)",
    "doi": null,
    "study_design": "Randomized controlled trial; patients were randomly allocated to 1 of 4 groups, with allocation key known only to the hospital pharmacist and nurse administering injections",
    "inclusion_criteria": "Patients between the ages of 18 and 65, attending the out-patient department for regular injections of long-term phenothiazines, previously diagnosed as schizophrenic by criteria generally accepted in the United Kingdom, and with documented evidence of at least one of Schneider’s first-rank symptoms of schizophrenia during an acute phase.",
    "exclusion_criteria": "Patients were excluded if they required EOT or had evidence of epilepsy, brain damage, marked mental retardation or Parkinsonism, or were pregnant.",
    "study_setting": "Out-patient department of a psychiatric unit in a general hospital (Hope Hospital, Salford); all patients were living in the community.",
    "source_of_recruitment": "Consecutive patients from the list of those attending the out-patient department of a psychiatric unit in a general hospital (Hope Hospital, Salford) for regular injections of long-term phenothiazines.",
    "number_of_participants_randomized": "60",
    "number_of_participants_analyzed": "53",
    "dropout_reasons": "One patient became pregnant, and six relapsed - three on fluphenazine decanoate and three on flupenthixol.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
