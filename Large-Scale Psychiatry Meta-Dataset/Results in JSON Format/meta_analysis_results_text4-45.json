{
  "study_info": {
    "study_id": "text4-45",
    "title": "Relapse prevention study of paliperidone extended-release tablets in Chinese patients with schizophrenia",
    "authors": "Qing Rui, Yang Wang, Shu Liang, Yanning Liu, Yue Wu, Qingqi Wu, Isaac Nuamah, Srihari Gopal",
    "year": "2014",
    "journal": "Progress in Neuro-Psychopharmacology & Biological Psychiatry",
    "country": "China",
    "doi": null,
    "study_design": "Phase 3, placebo-controlled, parallel-group, relapse prevention study with randomization (1:1) to paliperidone ER or placebo during the double-blind phase. Randomization was performed via an online interactive web-based response system and/or interactive voice response system.",
    "inclusion_criteria": "Patients of either sex, aged ≥18 years, diagnosed with schizophrenia based on DSM-IV-TR for at least 1 year before screening, and a PANSS total score between 70 and 120 (inclusive), at screening and baseline were eligible for enrollment.",
    "exclusion_criteria": "Major exclusion criteria for the study included: drug dependence (excluding nicotine and caffeine dependence) within 6 months before screening according to DSM-IV, history of cardiovascular, respiratory, neurologic, renal, hepatic, endocrine, or immunologic diseases, presence of circumstances that may increase the risk of the occurrence of torsade de pointes or sudden death, heart rate <50 bpm, presence of congenital prolongation of the QT interval or demonstration of repeated prolonged QTc Fridericia interval >450 ms in >1 electrocardiogram (ECG), neuroleptic malignant syndrome and hypersensitivity to risperidone, paliperidone, or their excipients. Patients treated with clozapine for treatment refractory or treatment resistant schizophrenia, monoamine oxidase inhibitor antidepressants within 4 weeks before screening, depot antipsychotic drugs within 120 days, paliperidone palmitate within 10 months or electroconvulsive therapy within 60 days before screening, and pregnant and lactating women were all excluded from the study.",
    "study_setting": "18 sites within the People's Republic of China",
    "source_of_recruitment": null,
    "number_of_participants_randomized": "136",
    "number_of_participants_analyzed": "135",
    "dropout_reasons": "During the run-in phase, 40 patients (20%) withdrew, with 9 (22.5%) withdrawing due to failure to meet criteria. During the stabilization phase, 25 patients (15.5%) withdrew, including 4 (16%) due to adverse events. During the double-blind phase, 5 patients (7%) withdrew from the placebo group (1 due to adverse event, 3 due to withdrawal of consent, 1 due to other reasons) and 14 patients (22%) withdrew from the pali ER group (9 due to withdrawal of consent, 3 due to lost to follow-up, 2 due to pregnancy).",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
