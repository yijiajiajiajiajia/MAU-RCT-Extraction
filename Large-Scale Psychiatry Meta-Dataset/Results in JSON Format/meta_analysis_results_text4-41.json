{
  "study_info": {
    "study_id": "text4-41",
    "title": "Prevention of Schizophrenia Relapse with Extended Release Quetiapine Fumarate Dosed Once Daily: A Randomized, Placebo-Controlled Trial in Clinically Stable Patients",
    "authors": "JOSEPH PEUSKENS, JITENDRA TRIVEDI, SERGIY MALYAROV, MARTIN BRECHER, OLA SVENSSON, FRANK MILLER, INGER PERSSON, AND DIDIER MEULIEN ON BEHALF OF THE STUDY D1444C00004 INVESTIGATORS",
    "year": null,
    "journal": null,
    "country": "Bulgaria, India, Poland, Russia, and Ukraine",
    "doi": null,
    "study_design": "One-year, multicenter, randomized, double-blind, parallel group, placebo-controlled study. Randomization method not further specified.",
    "inclusion_criteria": "Ages ≥18 to ≤65 years; documented clinical diagnosis of schizophrenia (DSM-IV) for at least two years; clinically stable before entering the stabilization phase (CGI-S score ≤4 and unchanged treatment [both compound and dose] with antipsychotic agent[s] within four weeks prior to entering the study); PANSS total score ≤60 at enrollment (Week 16).",
    "exclusion_criteria": "Treatment with depot antipsychotics within one dosing interval before enrollment (Week 16); pregnancy or breastfeeding; any DSM-IV Axis 1 disorder not defined in the inclusion criteria; any clinically significant deviations from the reference range in clinical laboratory test results at enrollment, as evaluated by the investigator; intolerance or lack of response to quetiapine; previous treatment with clozapine and/or valproic acid within two months of enrollment; and history of nonadherence, as judged by the investigator.",
    "study_setting": "Multicenter (26 sites) in five countries (Bulgaria, India, Poland, Russia, and Ukraine)",
    "source_of_recruitment": "Patients from centers in Bulgaria, India, Poland, Russia, and Ukraine",
    "number_of_participants_randomized": "197",
    "number_of_participants_analyzed": "197 (randomized phase); 327 (enrolled in open-label phase)",
    "dropout_reasons": "During stabilization phase: 130 discontinued (67 due to early termination of the study, 35 'not willing to continue', 4 due to AE, others for eligibility, nonadherence, lost to follow-up, etc.). During randomized phase: Placebo group—50 discontinued due to relapse, 14 for other reasons (12 'not willing to continue', 1 AE, 1 lost to follow-up); Quetiapine XR group—11 due to relapse, 5 for other reasons (including 'not willing to continue', lost to follow-up, etc.).",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
