    "year": "2000",
    "journal": "International Clinical Psychopharmacology",
    "country": "Belgium, France, Hungary, Italy, Latvia, Morocco, Slovenia, Spain, UK",
    "doi": null,
    "study_design": "Randomised, open, multicentre, parallel-group trial; patients were randomised in a 3:1 ratio amisulpride to haloperidol. The method of randomisation is not further specified.",
    "inclusion_criteria": "Patients with subchronic or chronic schizophrenia with acute exacerbation (paranoid, disorganised or undifferentiated) meeting the criteria of the revised DSM III-R (American Psychiatric Association, 1987). Patients had to have a minimum score of moderate (4 on a seven-point scale) on at least two of the four Brief Psychiatric Rating Scale (BPRS) positive items.",
    "exclusion_criteria": "Standard exclusion criteria for clinical trials, and patients with productive (positive) symptoms in whom the disorder did not correspond to a schizophrenic criteria: schizophreniform or schizoaffective disorder, maniac or excitative depressive states, and severe cardiovascular disease, Parkinson's disease or phaeochromocytoma.",
    "study_setting": "Multicentre, outpatient follow-up with possible initial hospitalisation",
    "source_of_recruitment": "Sixty-two centres in nine countries",
    "number_of_participants_randomized": "489 (370 to amisulpride, 119 to haloperidol)",
