{
  "study_info": {
    "study_id": "text4-7",
    "title": "Maintenance treatment with quetiapine versus discontinuation after one year of treatment in patients with remitted first episode psychosis: randomised controlled trial",
    "authors": "Eric Y H Chen, Christy L M Hui, May M L Lam, Cindy P Y Chiu, C W Law, Dicky W S Chung, Steve Tso, Edwin P F Pang, K T Chan, Y C Wong, Flora Y M Mo, Kathy P M Chan, T J Yao, S F Hung, William G Honer",
    "year": "2010",
    "journal": "BMJ",
    "country": "Hong Kong, Canada",
    "doi": "10.1136/bmj.c4024",
    "study_design": "Double-blind randomised controlled trial; randomisation sequence generated by computer with a fixed block size of four without stratification.",
    "inclusion_criteria": "Diagnosis of schizophrenia or non-affective psychosis (schizophreniform disorder, schizoaffective disorder, brief psychotic disorder, or psychosis not otherwise specified) according to DSM-IV; aged 18 to 65; received antipsychotic drug treatment continuously for at least 12 months; no history of relapse (defined as any increase in positive symptoms leading to adjustment of drug treatment or readmission to hospital); non-psychotic at study entry (below threshold scores on five key psychotic symptoms on the positive and negative syndrome scale, as well as free of positive symptoms of psychosis for at least eight weeks); score 2 or below on the clinical global impressions scale.",
    "exclusion_criteria": "Drug induced psychosis; current treatment with clozapine or depot antipsychotics or with mood stabilising drugs (lithium, valproate, or carbamazepine); poor adherence to treatment (missing >50% of drug, >50% non-attendance at follow-up clinic visits, or a history of patient initiated discontinuation of treatment); risk of suicide or violence.",
    "study_setting": "Specialised psychiatric care teams in Hong Kong, including the Early Assessment Service for Young People with Psychosis (EASY) programme, and multiple hospital sites.",
    "source_of_recruitment": "Consecutive patients already enrolled in the early psychosis programme (EASY) in Hong Kong.",
    "number_of_participants_randomized": 178,
    "number_of_participants_analyzed": 178,
    "dropout_reasons": "Adverse events, serious adverse events, withdrew consent, need for a mood stabiliser, inability to tolerate the transition protocol, unwillingness to attend the study assessments.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
