{
  "study_info": {
    "study_id": "text4-23",
    "title": "Functional outcomes in schizophrenia: a comparison of olanzapine and haloperidol in a European sample",
    "authors": "S.H. Hamilton, E.T. Edgell, D.A. Revicki and A. Breiera",
    "year": "2000",
    "journal": "International Clinical Psychopharmacology",
    "country": "Austria, Belgium, Denmark, Finland, France, Germany, Italy, Luxembourg, Netherlands, Portugal, Spain, Sweden, UK (European sample)",
    "doi": null,
    "study_design": "Double-blind, randomized clinical trial; patients were randomized in a 2:1 ratio to receive olanzapine or haloperidol after an antipsychotic washout period. The method of randomization is not further specified.",
    "inclusion_criteria": "Inpatients or outpatients with a documented DSM-III-R diagnosis of schizophrenia, schizophreniform disorder, or schizoaffective disorder; at least 18 years old; and either had a Brief Psychiatric Rating Scale (BPRS) total score of ≥18 and/or were no longer tolerating current neuroleptic (excluding haloperidol) therapy.",
    "exclusion_criteria": "Documented treatment-resistance to neuroleptic agents, DSM-III-R organic mental disorder or substance-use disorder, and/or a serious, unstable medical illness.",
    "study_setting": "Multicenter (96 clinical centres in 13 European countries), including both inpatients and outpatients.",
    "source_of_recruitment": "Patients were recruited from 96 clinical centres in 13 European countries.",
    "number_of_participants_randomized": "778 (520 randomized to olanzapine and 258 randomized to haloperidol)",
    "number_of_participants_analyzed": "Acute phase: 778; Maintenance phase: 423 (319 olanzapine-treated and 104 haloperidol-treated patients)",
    "dropout_reasons": "The most common reason for discontinuation was lack of efficacy (olanzapine 17.9% versus haloperidol 23.3%, P=0.085). A significantly smaller percentage of olanzapine-treated compared to haloperidol-treated patients discontinued for an adverse event (3.7% versus 8.9%, P=0.004) and patient decision (3.5% versus 7.8%, P=0.013). Other reasons for discontinuation included loss to follow-up, criteria not met, and sponsor decision. Few patients discontinued for these reasons.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
