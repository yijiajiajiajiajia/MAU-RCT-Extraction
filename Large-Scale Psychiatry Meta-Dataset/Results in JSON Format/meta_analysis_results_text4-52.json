    "title": "Standard and Long-Acting Depot Neuroleptics in Chronic Schizophrenics An 18-Month Open Multicentric Study",
    "authors": "Pierre Simon, MD; Jacques Fermanian, MD; Daniel Ginestet, MD; Michèle-Annie Goujet, MD; Pierre Péron-Magnan, MD",
    "year": "1978",
    "journal": "Archives of General Psychiatry",
    "country": "France",
    "doi": null,
    "study_design": "18-month open multicentric randomized controlled trial; randomization by balanced randomization at the center level (method not further specified)",
    "inclusion_criteria": "Male and female chronic schizophrenic patients (ages 21 to 45 years), as defined by official French classification of mental illness, including simple, hebephrenic, catatonic, paranoid, schizoaffective, and residual schizophrenias; illness duration of more than three years; maintenance neuroleptic chemotherapy for at least 18 months deemed necessary.",
    "exclusion_criteria": "Somatic illness, lobotomy, Sakel cure during the three previous years, or known intolerance to neuroleptics.",
    "study_setting": "15 psychiatric wards in French hospitals",
    "source_of_recruitment": "All French hospital psychiatrists were asked to participate; patients were recruited from 15 randomly chosen wards.",
    "number_of_participants_randomized": "181",
    "number_of_participants_analyzed": "163",
    "dropout_reasons": "Lost to follow-up, causes certainly independent of treatment, drug intolerance, drug ineffectiveness, depressive state.",
