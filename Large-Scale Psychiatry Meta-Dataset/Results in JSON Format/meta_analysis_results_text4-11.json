    "title": "A COMPARISON OF RISPERIDONE AND HALOPERIDOL FOR THE PREVENTION OF RELAPSE IN PATIENTS WITH SCHIZOPHRENIA",
    "authors": "JOHN G. CSERNANSKY, M.D., RAMY MAHMOUD, M.D., M.P.H., AND RONALD BRENNER, M.D., FOR THE RISPERIDONE-USA-79 STUDY GROUP",
    "year": "2002",
    "journal": "The New England Journal of Medicine",
    "country": "United States",
    "doi": null,
    "study_design": "Double-blind, prospective, randomized controlled trial; randomization method not specified in detail.",
    "inclusion_criteria": "Age 18 to 65 years; diagnosis of schizophrenia or schizoaffective disorder according to DSM-IV; inpatient psychiatric hospitalization, daytime psychiatric hospitalization, outpatient crisis management, or short-term treatment in a psychiatric hospital emergency room within the 24 months before study entry; received a stable dose of antipsychotic medication for at least 30 days before entry; resided at the same address for at least 30 days before entry; judged clinically stable by the principal investigator at each site.",
    "exclusion_criteria": "Another current DSM-IV Axis I diagnosis; Axis II diagnosis of borderline personality disorder or antisocial personality disorder; current substance dependence or abuse; clinically significant or unstable medical illness; current treatment with clozapine; history of refractoriness to antipsychotic drugs; treatment with depot neuroleptic injections within one treatment cycle before screening; allergy to risperidone or haloperidol; women who were pregnant or nursing.",
    "study_setting": "40 sites in the United States; adult outpatients in stable condition with chronic schizophrenia or schizoaffective disorder.",
    "source_of_recruitment": "Patients were recruited at 40 sites (locations listed in Appendix).",
    "number_of_participants_randomized": "397",
