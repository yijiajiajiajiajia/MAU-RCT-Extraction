{
  "study_info": {
    "study_id": "text4-25",
    "title": "Drug and Sociotherapy in the Aftercare of Schizophrenic Patients One-Year Relapse Rates",
    "authors": "Gerard E. Hogarty, MSW, Baltimore; Solomon C. Goldberg, Rockville, Md; and the Collaborative Study Group, Baltimore",
    "year": null,
    "journal": null,
    "country": "United States (Maryland)",
    "doi": null,
    "study_design": "Multicenter, randomized, double-blind, controlled trial. Initial random assignment to sociotherapy (MRT) or not at intake, then after two months, random assignment (double-blind) to drug (chlorpromazine) or placebo using identical looking tablets.",
    "inclusion_criteria": "1) Age 18-55; 2) Primary hospital diagnosis of schizophrenia confirmed by research psychiatrist; 3) Currently hospitalized for less than 2 years; 4) No evidence of organic brain syndrome; 5) IQ above 70; 6) No history of unmanageable drinking or drug abuse; 7) No history of serious suicidal or homicidal behavior during drug-free intervals; 8) Received phenothiazine as inpatient and no medical contraindications for chlorpromazine; 9) Live within commuting distance of clinic; 10) Provide a 'significant other' for rating and supervision; 11) Appear at clinic within 21 days of discharge; 12) Receive no other ataractic than study medication during investigation. Only wage earners and homemakers included, students excluded.",
    "exclusion_criteria": "Organic brain syndrome, IQ ≤ 70, unmanageable drinking or drug abuse, serious suicidal or homicidal behavior during drug-free intervals, medical contraindications for chlorpromazine, not living within commuting distance, unable to provide a significant other, not appearing at clinic within 21 days of discharge, receiving other ataractic drugs, students.",
    "study_setting": "Three Maryland State hospitals serving Baltimore city (Crownsville, Springfield, and Spring Grove Hospitals) and their affiliated outpatient clinics.",
    "source_of_recruitment": "Consecutive discharges of eligible patients from three Maryland State hospitals to affiliated outpatient clinics over an 18-month period.",
    "number_of_participants_randomized": 374,
    "number_of_participants_analyzed": 374,
    "dropout_reasons": "Refused to attend clinic after discharge, moved, failed to meet criteria, died (non-treatment-related), side effects of chlorpromazine, sought treatment elsewhere, intercurrent medical illness, allergic reactions to chlorpromazine, hidden addictions, arrested, problems with another agency, drug therapy interfered with employment.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
