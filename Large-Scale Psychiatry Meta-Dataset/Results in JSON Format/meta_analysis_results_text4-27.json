{
  "study_info": {
    "study_id": "text4-27",
    "title": "Paliperidone palmitate maintenance treatment in delaying the time-to-relapse in patients with schizophrenia: A randomized, double-blind, placebo-controlled study",
    "authors": "David Hough, Srihari Gopal, Ujjwala Vijapurkar, Pilar Lim, Margarita Morozova, Mariëlle Eerdekens",
    "year": "2010",
    "journal": "Schizophrenia Research",
    "country": "Multi-country (Costa Rica, Korea, Mexico, Romania, Russia, South Africa, Taiwan, Ukraine, United States of America)",
    "doi": null,
    "study_design": "Randomized, double-blind, placebo-controlled study; randomization was performed via a sponsor-prepared computer-generated randomization scheme, assigned by an interactive voice-response system.",
    "inclusion_criteria": "Men and women, aged 18–65 years (inclusive), with a diagnosis of schizophrenia (DSM-IV criteria) for at least 1 year before screening, and a Positive and Negative Syndrome Scale (PANSS) total score below 120, at screening and baseline. Both symptomatic and stable patients were eligible.",
    "exclusion_criteria": "Primary, active DSM-IV diagnosis other than schizophrenia; significant risk of suicidal or aggressive behavior; history of substance dependence within 3 months before screening; significant medical conditions, or treatment resistance (failure to respond to 2 adequate trials, minimum 4 weeks of antipsychotic medications); use of any 4-week depot antipsychotic within 28 days or risperidone LAI within 5 weeks before screening; use of oral antipsychotics, mood stabilizers, or other prescription or over-the-counter drugs within 2 days before baseline; or involuntary admission to a psychiatric hospital. Women were excluded if pregnant, nursing, or planning to become pregnant.",
    "study_setting": "Multicenter, 56 centers in 9 countries",
    "source_of_recruitment": "Patients were recruited from 56 centers in 9 countries.",
    "number_of_participants_randomized": "410",
    "number_of_participants_analyzed": "Final analysis: 408 (Placebo: 203, Paliperidone palmitate: 205)",
    "dropout_reasons": "Screening phase: 102 screen failures (1 due to subject choice, 25 due to adverse events, 76 other reasons). Transition phase: 168 dropouts (27 due to unmet criteria, 25 due to adverse events, 52 due to subject choice, 64 other reasons). Maintenance phase: 195 dropouts (25 due to unmet criteria, 26 due to adverse events, 3 deaths, 55 due to subject choice, 86 other reasons). Double-blind phase: Placebo group: 28 dropped out (2 due to adverse events, 15 due to subject choice, 11 other reasons); Paliperidone palmitate group: 30 dropped out (14 other reasons).",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
