    "study_design": "Double-blind, randomized, placebo-controlled trial. Random allocation to treatment groups; method of randomization not further specified.",
    "inclusion_criteria": "Men and women aged 18-65 years; met DSM-III-R criteria for schizophrenia (295.1-295.3, 295.9) as established by clinical interview and chart review; minimum BPRS-total score (items scored 0-6) extracted from PANSS of at least 24; CGI-S score ≥4; off oral neuroleptics for at least 2 days and off depot neuroleptics for at least one dosing interval (minimum of 2 weeks) prior to starting the study; written informed consent.",
    "exclusion_criteria": "Residual Type 295.6 schizophrenia; DSM-III-R organic mental disorder or substance-use disorder active within 3 months of study entry; serious suicidal risk; serious, unstable medical illness; Parkinson's disease; myasthenia gravis; illness contraindicating use of anticholinergic medication; history of a seizure disorder; history of leukopenia without known etiology; significantly elevated (greater than approximately 3 times the conventional laboratory upper limit of normal) liver function test results, active hepatitis B, or jaundice; prior participation in any olanzapine clinical trial.",
    "study_setting": "12 study sites in the United States; hospitalization required during placebo lead-in and first 2 weeks of double-blind therapy; patients could be discharged to outpatient status after 2 weeks if criteria met.",
    "source_of_recruitment": "Approximately half the patients in each treatment group were recruited while inpatients; high proportions of patients were recruited during lengthy hospitalizations.",
    "number_of_participants_randomized": "152",
    "number_of_participants_analyzed": "152 for baseline and adverse event analyses; for efficacy and endpoint analyses, n=49 (placebo), n=51 (Olz1.0), n=49 (Olz10.0) (see Table 5)",
    "dropout_reasons": "Adverse event, lack of efficacy, lost to follow-up, patient decision. Discontinuation for adverse events was low. Many patients discontinued to cross over to open-label olanzapine due to lack of efficacy.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
