  "study_info": {
    "study_id": "text4-16",
    "title": "Clopenthixol and flupenthixol depot preparations in outpatient schizophrenics I. A ONE YEAR DOUBLE-BLIND STUDY OF CLOPENTHIXOL DECANOATE AND FLUPENTHIXOL PALMITATE",
    "authors": "S. J. DENCKER, M. LEPP AND U. MALM",
    "year": "1974-75",
    "journal": null,
    "country": "Sweden",
    "doi": null,
    "study_design": "Prospective one-year double-blind randomized trial. Patients were allocated at random to treatment with clopenthixol decanoate or flupenthixol palmitate. The method of randomization is not further specified.",
    "inclusion_criteria": "1) Diagnosis of schizophrenic syndrome according to NIMH collaborative study (1964) criteria (closely related to Schneiderian criteria), i.e., presence on admission of two or more of: thinking or speech disturbances, catatonic motor behaviour, paranoid ideation, hallucinations, delusional thinking other than paranoid, blunted or inappropriate emotion, disturbance of behaviour and interpersonal relationships; 2) Chronic schizophrenics treated as outpatients after earlier admission to hospital and rehabilitation training periods; 3) Treated with depot neuroleptics in the last three years; 4) Free from relapse for at least 15 months.",
    "exclusion_criteria": "1) Participation in another study; 2) Did not wish to change neuroleptic medication; 3) Given injections more often than every four weeks or received higher doses than those permitted during pretrial.",
    "study_setting": "Outpatient clinic at Lillhagen Hospital, Gothenburg, Sweden.",
    "source_of_recruitment": "All outpatients attending the clinic were reviewed.",
    "number_of_participants_randomized": 60,
    "number_of_participants_analyzed": 50,
    "dropout_reasons": "Unsatisfactory effect (7), dead in physical disease (1), moved to other city (1), refused to continue (1).",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
