{
  "study_info": {
    "study_id": "text4-15",
    "title": "A CONTROLLED ONE-YEAR STUDY OF PIPOTIAZINE PALMITATE AND FLUPHENAZINE DECANOATE IN CHRONIC SCHIZOPHRENIC SYNDROMES Evaluation of results at 6 and 12 months’ trial",
    "authors": "S. J. DENCKER, K. FRAIUKENBERG, U. MALM AND B. ZELL",
    "year": "1972",
    "journal": null,
    "country": null,
    "doi": null,
    "study_design": "Double-blind, randomized, controlled trial. Patients were matched for sex and age (10 year classes), and distributed randomly between the treatment series. The double blind technique was applied.",
    "inclusion_criteria": "1. Only patients treated with long-acting neuroleptics. 2. The diagnosis should fall within the category of schizophrenic syndromes. 3. Age between 18 and 65 years. 4. Duration of disease: >3 years; hospitalisation: <10 years",
    "exclusion_criteria": "1. Patients with toxicomania (alcoholism or narcomania). 2. Patients with symptoms suggesting neurological or other somatic disorders. 3. Patients treated with high doses (at least 250 mg, single dose) of fluphenazine enanthate.",
    "study_setting": "Patients from the department who needed maintenance therapy with neuroleptics; both in-patients and out-patients included.",
    "source_of_recruitment": "All patients from the department who needed maintenance therapy with neuroleptics and met the following requirements were accepted for the trial.",
    "number_of_participants_randomized": "67",
    "number_of_participants_analyzed": "58",
    "dropout_reasons": "One patient in the PP-series, a 25-year old man, was excluded from the trial after one month because of attacks of choking, probably due to acute extrapyramidal side-effects. The patient afterwards refused to take the drug. The other was a patient of the FD-series whose symptoms of schizophrenia worsened and was excluded from the trial during the second month because other neuroleptics had to be added. Two patients in the PP-series and five in the FD-series were excluded during the last six months’ trial-in all these seven cases the exclusion was due to increased schizophrenic symptoms.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
