{
  "study_info": {
    "study_id": "text4-34",
    "title": "A Prospective Study Comparing the Long-term Effectiveness of Injectable Risperidone Long-acting Therapy and Oral Aripiprazole in Patients with Schizophrenia",
    "authors": "WAYNE MACFADDEN, MD; YI-WEN MA, PhD; J. THOMAS HASKINS, PhD; CYNTHIA A. BOSSIE, PhD; and LARRY ALPHS, MD, PhD",
    "year": "2010",
    "journal": "Psychiatry (Edgemont)",
    "country": "United States, South America, and India",
    "doi": null,
    "study_design": "Two-year, prospective, blinded-rater, open-label, active-controlled, multicenter, randomized study. Randomization was in a 1:1 ratio, but the method of randomization (e.g., computer-generated, random number table) was not specified.",
    "inclusion_criteria": "Men and women over 18 years of age with a DSM-IV diagnosis of schizophrenia who, according to clinician judgment, were not adequately benefiting from their current antipsychotic. Must have experienced at least two psychotic relapses in the two years before study entry. Subjects experiencing a recent relapse must have been stabilized for a minimum of two months before study entry, per clinician judgment.",
    "exclusion_criteria": "Screening PANSS total score of 100 or more; current hospitalization, major medication changes, or worsening of psychiatric symptoms within two months before study entry; current treatment with clozapine or carbamazepine; depot antipsychotic treatment or evidence of alcohol or drug dependence (DSM-IV Axis I criteria) within six months before entry.",
    "study_setting": "Multicenter clinical trial, conducted in the United States, South America, and India.",
    "source_of_recruitment": "Multiple clinical centers in the United States, South America, and India.",
    "number_of_participants_randomized": 355,
    "number_of_participants_analyzed": 349,
    "dropout_reasons": "The main causes of early discontinuation were withdrawal of consent (RLAT, 14.1%; aripiprazole, 13.0%) and lost to follow-up (RLAT, 10.1%; aripiprazole, 5.7%). No subjects withdrew from the study because of an AE (as the primary reason) with RLAT, and 2.3 percent withdrew because of an AE with aripiprazole; 2.2 percent of RLAT and 1.7 percent of aripiprazole subjects withdrew for lack of efficacy.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
