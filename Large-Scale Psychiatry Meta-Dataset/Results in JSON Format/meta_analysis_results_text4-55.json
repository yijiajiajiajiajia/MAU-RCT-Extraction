  "study_info": {
    "study_id": "text4-55",
    "title": "Zuclopenthixol decanoate and haloperidol decanoate in chronic schizophrenia: a double-blind multicentre study",
    "authors": "Wistedt B, Koskinen T, Thelander S, Nerdrum T, Pedersen V, Mulbjerg C.",
    "year": "1991",
    "journal": "Acta Psychiatrica Scandinavica",
    "country": "Finland and Sweden",
    "doi": null,
    "study_design": "Double-blind, multicentre, randomized controlled trial using a triple-blind technique; randomization after at least 3 months of open-label treatment; blinding maintained by nurse-administered injections with access to code but not involved in assessment.",
    "inclusion_criteria": "Outpatients of either sex aged between 25 and 60 years with a diagnosis of chronic schizophrenia according to DSM-III; stabilized on either zuclopenthixol decanoate or haloperidol decanoate for a minimum of 3 months; total score on the 18-item Brief Psychiatric Rating Scale (BPRS) between 5 and 26.",
    "exclusion_criteria": "Total duration of illness less than 2 years; duration of hospitalization of more than 10 years; drug or alcohol abuse; pregnancy; known organic brain disorder; uncompensated somatic illness; receiving doses higher than 600 mg zuclopenthixol decanoate or 150 mg haloperidol decanoate per injection.",
    "study_setting": "Outpatient clinics in Finland and Sweden",
    "source_of_recruitment": "Outpatients with chronic schizophrenia attending clinics in Finland and Sweden",
    "number_of_participants_randomized": "64",
    "number_of_participants_analyzed": "61",
    "dropout_reasons": "Two patients allocated to zuclopenthixol decanoate were withdrawn for administrative reasons unrelated to test treatment; 1 patient allocated to haloperidol decanoate was withdrawn because of side effects; 4 patients in the HAL-D group were withdrawn because of deterioration; 1 patient in the ZPT-D group committed suicide.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
