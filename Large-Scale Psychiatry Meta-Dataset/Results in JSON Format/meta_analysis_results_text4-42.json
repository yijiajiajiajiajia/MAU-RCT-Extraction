{
  "study_info": {
    "study_id": "text4-42",
    "title": "Aripiprazole for the Prevention of Relapse in Stabilized Patients With Chronic Schizophrenia: A Placebo-Controlled 26-Week Study",
    "authors": "Teresa A. Pigott, M.D.; William H. Carson, M.D.; Anutosh R. Saha, Ph.D.; Anne F. Torbeyns, Ph.D.; Elyse G. Stock, M.D.; and Gary G. Ingenito, M.D., for the Aripiprazole Study Group",
    "year": "2003",
    "journal": "The Journal of Clinical Psychiatry",
    "country": "United States, Czech Republic, Poland, Russia, and Ukraine",
    "doi": null,
    "study_design": "Multicenter, randomized, double-blind, placebo-controlled, parallel-group study. Randomization method not further specified.",
    "inclusion_criteria": "Men and women aged ≥18 years; confirmed diagnosis of schizophrenia by DSM-IV criteria; diagnosis made at least 2 years prior to entry; continued antipsychotic treatment during this period; stable condition at entry (no significant improvement or worsening of symptoms within the past 3 months); mean baseline PANSS total score of at least 60; score of not more than 4 (moderate) on the subscale for hostility or uncooperativeness; score no more than 4 (moderately ill) on the CGI-S; women of childbearing potential had to test negative for pregnancy and use reliable contraception.",
    "exclusion_criteria": "Experiencing acute relapse; psychiatric disorder other than schizophrenia; history of or current delirium, dementia, amnesia, or cognitive disorder; known treatment resistance to antipsychotics; received fluoxetine within 4 weeks of randomization; dependent on benzodiazepines or history of alcohol or substance abuse; receiving long-acting antipsychotic and last dose administered less than 1 full cycle plus 1 week prior to randomization; significant risk of suicide; history of neuroleptic malignant syndrome, thyroid pathology, or hypersensitivity to aripiprazole or other quinolinones; enrolled in an aripiprazole clinical study or any clinical trial with an investigational agent within the last month; exposed to electroconvulsive therapy within 2 months of randomization.",
    "study_setting": "31 centers in the United States, Czech Republic, Poland, Russia, and Ukraine; patients were clinically supervised daily under full hospitalization, partial hospitalization, day treatment, or supervised group living at home or other appropriate supervised arrangement.",
    "source_of_recruitment": "Patients were recruited from 31 centers in the United States, Czech Republic, Poland, Russia, and Ukraine.",
    "number_of_participants_randomized": "310",
    "number_of_participants_analyzed": "297",
    "dropout_reasons": "Lack of efficacy (relapse), patient withdrew consent, adverse event, patient unreliability, lost to follow-up, death, other known causes (laboratory abnormalities, positive cannabinoid screening, anemia, noncompliance, and randomization error).",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
