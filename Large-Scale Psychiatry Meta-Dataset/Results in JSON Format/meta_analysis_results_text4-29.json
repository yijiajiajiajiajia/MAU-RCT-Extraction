{
  "study_info": {
    "study_id": "text4-29",
    "title": "One-year double-blind study of the neurocognitive efficacy of olanzapine, risperidone, and haloperidol in schizophrenia",
    "authors": "Richard S.E. Keefe, Carrie A. Young, Stephanie L. Rock, Scot E. Purdon, James M. Gold, Alan Breier, HGGN Study Group",
    "year": "2006",
    "journal": "Schizophrenia Research",
    "country": "United States and Canada",
    "doi": "10.1016/j.schres.2005.07.038",
    "study_design": "Double-blind, randomized, controlled, parallel study. Randomization was in a 1:1:1 ratio to olanzapine, risperidone, or haloperidol. The method of randomization is not further specified.",
    "inclusion_criteria": "Patients 18 to 55 years of age, with a mean age of 39 years, who met the criteria for schizophrenia or schizoaffective disorder as defined in the DSM-IV, and at visit 1 had a minimum score of 4 on at least 2 positive items on the Positive and Negative Symptoms Scale (PANSS; scored 1–7) and a score of 18 or more (items scored 0–6) on the Brief Psychiatric Rating Scale (BPRS). Patients were to be English-speaking, have a level of understanding sufficient to agree to all tests and examinations, and had illness duration of at least 2 years from first hospitalization and/or diagnosis/treatment. Female patients of childbearing potential must have been using a medically accepted means of contraception.",
    "exclusion_criteria": "Patients were excluded if they previously participated in the present study, participated in a clinical trial of another investigational drug within 1 month prior to study entry, or participated in a study within the past 3 months that included the neurocognitive battery. Other exclusion criteria were any significant neurological disorder, head injury with loss of consciousness, serious illness such that death was anticipated within 1 year or intensive care hospitalization was anticipated within 6 months, QTc interval greater than 450 ms, uncorrected hypo- or hyperthyroidism, current agranulocytosis, female patients who were either pregnant or nursing, allergic reaction to study medication, DSM-IV substance dependence (except caffeine and nicotine) within the past 2 months, treatment with depot antipsychotics, reversible monoamine oxidase inhibitor within 2 weeks, or clozapine or electroconvulsive therapy (ECT) within 1 month.",
    "study_setting": "39 sites in the United States and Canada",
    "source_of_recruitment": "Inpatients or outpatients with schizophrenia and schizoaffective disorder",
    "number_of_participants_randomized": "414",
    "number_of_participants_analyzed": "414",
    "dropout_reasons": "Adverse event, satisfactory response, lack of efficacy, lost to follow-up, patient decision, physician decision, criteria not met/compliance, sponsor decision.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
