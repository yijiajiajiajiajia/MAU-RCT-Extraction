{
  "study_info": {
    "study_id": "text4-18",
    "title": "Haloperidol decanoate and flupenthixol decanoate in schizophrenia: A long-term double-blind cross-over comparison",
    "authors": "G. Eberhard and E. Hellbom",
    "year": "1986",
    "journal": "Acta Psychiatrica Scandinavica",
    "country": "Sweden",
    "doi": null,
    "study_design": "48-week double-blind, cross-over study; patients were randomized in groups of six to start either on HALd or on FLUd. No wash-out period. Randomization method: not detailed.",
    "inclusion_criteria": "Presence of schizophrenic symptoms according to the DSM III-criteria, requiring at least a 1-year treatment with depot neuroleptics. Both orally treated patients, and those already on depot neuroleptics were admitted to the study.",
    "exclusion_criteria": "Old, deteriorated patients were excluded. Other reasons for exclusion were serious somatic diseases incompatible with neuroleptic therapy, impaired liver or kidney function, acute heart failure and treatment with barbiturates or antiepileptics.",
    "study_setting": "Dept. of Psychiatry, University of Lund, Malmo General Hospital, and Janssen-Pharma, V. Frolunda. Sweden",
    "source_of_recruitment": "Not explicitly stated, but implied to be patients from the Dept. of Psychiatry, University of Lund, Malmo General Hospital, and possibly other centers (multicentre trial).",
    "number_of_participants_randomized": 38,
    "number_of_participants_analyzed": 32,
    "dropout_reasons": "Three previously on HALd relapsed after 4-6 weeks on FLUd. One was admitted to hospital and all three were given other neuroleptics than FLUd. Two of the three patients on FLUd relapsed after 16 weeks on HALd and one developed a skin reaction, later found not related to HALd.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
