{
  "study_info": {
    "study_id": "text4-32",
    "title": "Paliperidone Extended-Release Tablets for Prevention of Symptom Recurrence in Patients With Schizophrenia: A Randomized, Double-Blind, Placebo-Controlled Study",
    "authors": "Michelle Kramer, MD,* George Simpson, MD,y Valentinas Maciulis, MD, PhD,z Stuart Kushner, MD,* Ujjwala Vijapurkar, PhD,* Pilar Lim, PhD,* and Marie¨lle Eerdekens, MD, MBA*",
    "year": "2007",
    "journal": "Journal of Clinical Psychopharmacology",
    "country": "United States, Romania, Turkey, Latvia, Lithuania, and India",
    "doi": null,
    "study_design": "Randomized, double-blind, placebo-controlled, multicenter study. Randomization was performed 1:1 via a sponsor-prepared, computer-generated randomization and stratification scheme, assigned by an interactive voice-response system.",
    "inclusion_criteria": "Men and women, with ages from 18 to 65 years, were enrolled, provided they (1) had a diagnosis of schizophrenia (Diagnostic and Statistical Manual of Mental Disorders, Fourth Edition [DSM-IV]) for at least 1 year and (2) were experiencing an acute episode of schizophrenia (Positive and Negative Syndrome Scale [PANSS] total score, 70–120). Patients were required to be physically healthy, capable of being compliant with self-administration of medication or have consistent help available throughout the study, and able to complete self-administered questionnaires.",
    "exclusion_criteria": "Patients were excluded if they had a DSM-IV Axis I diagnosis other than schizophrenia, if they had a DSM-IV Axis I diagnosis of substance dependence (except nicotine or caffeine) within 6 months before screening, or if they were considered to have a significant risk of suicidal or aggressive behavior. In addition, patients were excluded if they had medical conditions that could potentially alter the absorption, metabolism, or excretion of the study medication; relevant history of significant or unstable disease; known allergic reactions to barbiturates, carbamazepine, lamotrigine, phenytoin, paliperidone, or risperidone; a previous lack of response to risperidone; used a depot antipsychotic within 120 days; exposure to experimental treatment within 90 days before screening; electroconvulsive treatment within 3 months before screening; or had involuntary admission to a psychiatric hospital. Women were excluded if pregnant, nursing, or planning to become pregnant. Patients were encouraged to abstain from the use of alcohol or illicit substances for the entire study.",
    "study_setting": "Multicenter (45 centers in 6 countries), including both inpatient (hospitalized during run-in) and outpatient (after discharge) settings.",
    "source_of_recruitment": "45 centers in 6 countries (United States, Romania, Turkey, Latvia, Lithuania, and India)",
    "number_of_participants_randomized": "207",
    "number_of_participants_analyzed": "205",
    "dropout_reasons": "Dropouts occurred due to criteria not met, adverse events, lost to follow-up, subject choice, noncompliance, or other reasons during run-in; during stabilization, 49 patients dropped out; during double-blind, discontinuations for reasons other than recurrence occurred in more paliperidone ER–treated patients (n=20, 19%) than placebo patients (n=8, 8%). The primary reason for discontinuation in paliperidone ER–treated patients was withdrawal of consent (n=12, 11%). No patients withdrew consent in the placebo group.",
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
