    "country": "Sweden",
    "doi": null,
    "study_design": "Single-center (two sites), prospective, open, randomized, parallel, interventional, superiority trial; 1:1 random assignment with block size of eight, stratified by gender and revascularization type (PCI/CABG)",
    "inclusion_criteria": "Adult patients with angiography-verified CAD who had undergone PCI or CABG in Skaraborg County, West Sweden, in the previous 6 months, and had an apnea-hypopnea index (AHI) of <5 / h or ≥15 / h during a sleep study",
    "exclusion_criteria": "Patients with existing OSA, an AHI of 5.0–14.9/h, and predominantly central apneas with Cheyne-Stokes respiration were excluded",
    "study_setting": "Single-center (two sites) in Skaraborg County, West Sweden",
    "source_of_recruitment": "Consecutive patients with newly revascularized coronary artery disease in Skaraborg County, West Sweden",
