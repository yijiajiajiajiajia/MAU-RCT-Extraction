  "study_info": {
    "study_id": "text2-1",
    "title": "CPAP for Prevention of Cardiovascular Events in Obstructive Sleep Apnea",
    "authors": "R. Doug McEvoy, M.D., Nick A. Antic, M.D., Ph.D., Emma Heeley, Ph.D., Yuanming Luo, M.D., Qiong Ou, M.D., Xilong Zhang, M.D., Olga Mediano, M.D., Rui Chen, M.D., Luciano F. Drager, M.D., Ph.D., Zhihong Liu, M.D., Ph.D., Guofang Chen, M.D., Baoliang Du, M.D., Nigel McArdle, M.D., Sutapa Mukherjee, M.D., Ph.D., Manjari Tripathi, M.D., Laurent Billot, M.Sc., Qiang Li, M.Biostat., Geraldo Lorenzi‑Filho, M.D., Ferran Barbe, M.D., Susan Redline, M.D., M.P.H., Jiguang Wang, M.D., Ph.D., Hisatomi Arima, M.D., Ph.D., Bruce Neal, M.D., Ph.D., David P. White, M.D., Ron R. Grunstein, M.D., Ph.D., Nanshan Zhong, M.D., and Craig S. Anderson, M.D., Ph.D., for the SAVE Investigators and Coordinators",
    "year": "2016",
    "journal": "The New England Journal of Medicine",
    "country": "International (7 countries)",
    "doi": "10.1056/NEJMoa1606599",
    "study_design": "International, multicenter, randomized, parallel-group, open-label trial, with blinded end-point assessment. Randomization was performed with the use of a minimization procedure to balance the group assignments according to site, type of cardiovascular disease (cardiac, cerebrovascular, or both), and severity of daytime sleepiness (Epworth Sleepiness Scale score <11 vs. ≥11).",
    "inclusion_criteria": "Age between 45 and 75 years, diagnosis of coronary artery disease or cerebrovascular disease, and diagnosis of moderate-to-severe obstructive sleep apnea (oxygen desaturation index of at least 12, established with a home sleep-study screening device and confirmed by review at a central core sleep laboratory). Minimum level of adherence to CPAP therapy (average of 3 hours per night) during a 1-week run-in period with sham CPAP.",
    "exclusion_criteria": "Severe daytime sleepiness (Epworth Sleepiness Scale score >15), increased risk of accident from falling asleep, very severe hypoxemia (oxygen saturation <80% for >10% of recording time), or pattern of Cheyne–Stokes respiration on the ApneaLink nasal pressure recording.",
    "study_setting": "89 clinical centers in 7 countries",
    "source_of_recruitment": "Clinical centers",
    "number_of_participants_randomized": "2717",
    "number_of_participants_analyzed": null,
    "dropout_reasons": null,
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
