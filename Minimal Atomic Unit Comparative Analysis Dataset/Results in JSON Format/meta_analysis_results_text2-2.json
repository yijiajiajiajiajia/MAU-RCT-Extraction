{
  "study_info": {
    "study_id": "text2-2",
    "title": "Effect of obstructive sleep apnoea and its treatment with continuous positive airway pressure on the prevalence of cardiovascular events in patients with acute coronary syndrome (ISAACC study): a randomised controlled trial",
    "authors": "Manuel Sánchez-de-la-Torre, Alicia Sánchez-de-la-Torre, Sandra Bertran, Jorge Abad, Joaquín Duran-Cantolla, Valentín Cabriada, Olga Mediano, María José Masdeu, Mari Luz Alonso, Juan Fernando Masa, Antonia Barceló, Mónica de la Peña, Mercè Mayos, Ramón Coloma, Josep M Montserrat, Eusebi Chiner, Salvador Perelló, Gemma Rubinós, Olga Mínguez, Lydia Pascual, Anunciación Cortijo, Dolores Martínez, Albina Aldomà, Mireia Dalmases, R Doug McEvoy, Ferran Barbé, on behalf of the Spanish Sleep Network",
    "year": "2019",
    "journal": "Lancet Respiratory Medicine",
    "country": "Spain",
    "doi": "10.1016/S2213-2600(19)30271-1",
    "study_design": "Multicentre, open-label, parallel-group, randomised controlled trial. Simple randomisation was done by a computerised system available 24 h a day via a fully secure, password-protected study website. The randomisation used the rand() function in PHP 7.3, returning a random value (0 or 1) for group assignment.",
    "inclusion_criteria": "Patients aged ≥18 years, admitted to hospital for ACS with a hospital stay of 24–72 h at the time of sleep study, and had an Epworth Sleepiness Scale (EES) score of ≤10 (ie, patients without excessive daytime sleepiness or non-sleepy).",
    "exclusion_criteria": "Previous treatment with CPAP for OSA; psychophysical inability to complete questionnaires; presence of any previously diagnosed sleep disorder; more than 50% central apnoeas or the presence of Cheyne–Stokes respiration; daytime sleepiness (ESS >10); chronic diseases; a medical history that could interfere with the study objectives or compromise conclusions; any medical factor, social or geographical, that might jeopardise patient compliance; any processes that reduce life expectancy to less than 1 year; and cardiogenic shock.",
    "study_setting": "15 hospitals across Spain",
    "source_of_recruitment": "Patients admitted to hospital for documented symptoms of ACS",
    "number_of_participants_randomized": "1264 patients with OSA were randomly assigned to the CPAP group (n=633) or the UC group (n=631).",
    "number_of_participants_analyzed": "2551 patients were recruited. 1264 patients with OSA were randomized. 1287 patients did not have OSA, of whom 603 were randomly assigned to the reference group.",
    "dropout_reasons": null,
    "meets_inclusion_criteria": true,
    "exclusion_reason": null
  },
